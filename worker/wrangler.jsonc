{
  // The game server: one Durable Object holds the whole room (positions, chat, kitchen).
  "name": "notawork-space",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
  // Secrets (set with `wrangler secret put`, or in worker/.dev.vars for local dev):
  //   ROOM_PASSWORD        optional shared password for the room
  //   LIVEKIT_URL          wss://<project>.livekit.cloud
  //   LIVEKIT_API_KEY
  //   LIVEKIT_API_SECRET
}
