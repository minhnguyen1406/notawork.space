{
  "name": "notawork-space",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server \"vite\" \"wrangler dev --config worker/wrangler.jsonc --port 8787\"",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit",
    "build": "npm run typecheck && vite build",
    "deploy:server": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "livekit-client": "^2.25.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
